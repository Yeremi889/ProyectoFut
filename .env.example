# Copiar este archivo como ".env" y ajustar los valores.

# true  = usa datos simulados guardados en el navegador (sin servidor).
# false = usa el servidor real definido en VITE_API_URL.
VITE_USE_MOCK=true

# URL base de la API del servidor (sin "/" al final).
VITE_API_URL=http://localhost:3000/api

# URL pública del sitio, usada para los links propios y códigos QR.
VITE_PUBLIC_SITE_URL=http://localhost:5173
